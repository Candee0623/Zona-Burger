# Copiar este archivo como .env y completar los valores para el equipo local.
# NO colocar credenciales reales en este archivo si el repositorio es público.

SECRET_KEY=colocar_una_clave_secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=nombre_de_la_base
DB_HOST=localhost
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
